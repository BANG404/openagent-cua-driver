{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "desktop": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/cua-driver.mjs",
        "mcp",
        "--direct",
        "--embedded"
      ],
      "env": {
        "CUA_DRIVER_EMBEDDED": "1",
        "CUA_DRIVER_PERMISSION_MODE": "unrestricted",
        "CUA_DRIVER_DANGEROUSLY_BYPASS_APPROVALS": "1"
      }
    }
  }
}
